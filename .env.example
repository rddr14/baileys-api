# Porta da aplicação
PORT=3000

# Configuração de Fallback do Webhook
# Se ativado (true), qualquer sessão sem webhook próprio cadastrado enviará eventos para a URL abaixo
WEBHOOK_FALLBACK_ENABLED=false
WEBHOOK_URL=http://localhost:8000/api/whatsapp/webhook

# Chave Secreta da API (opcional, altamente recomendada em produção)
# Se preenchida, exige o cabeçalho 'apikey: SUA_CHAVE' em todas as chamadas HTTP
# Deixe vazio para desativar autenticação
API_KEY=
